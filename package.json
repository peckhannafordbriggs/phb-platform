{
  "name": "phb-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx prisma/seed.ts",
    "seed:dev": "tsx prisma/seed-dev.ts",
    "db:test:setup": "tsx scripts/setup-test-db.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "7.9.1",
    "next": "15.5.23",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sanitize-html": "^2.17.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@microsoft/microsoft-graph-types": "^2.43.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "dotenv": "^17",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "prisma": "7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^4"
  },
  "allowScripts": {
    "prisma@7.9.1": true,
    "@prisma/engines@7.9.1": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "sharp@0.34.5": true
  }
