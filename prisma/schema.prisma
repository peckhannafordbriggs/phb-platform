generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmployeeStatus {
  active
  disabled
}

enum ModuleStatus {
  active
  hidden
}

enum ListItemStatus {
  active
  hidden
}

/// A company employee, created on first Entra sign-in and never by an admin.
model Employee {
  id String @id @default(uuid()) @db.Uuid

  entraOid String? @unique @map("entra_oid")

  email     String @unique
  firstName String @map("first_name")
  lastName  String @map("last_name")

  positionId String?   @map("position_id") @db.Uuid
  position   Position? @relation(fields: [positionId], references: [id], onDelete: Restrict)

  positionOther String? @map("position_other")

  departmentId String?     @map("department_id") @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  profileCompleted Boolean        @default(false) @map("profile_completed")
  status           EmployeeStatus @default(active)
  isPlatformAdmin  Boolean        @default(false) @map("is_platform_admin")

  sessionsValidAfter DateTime? @map("sessions_valid_after") @db.Timestamptz(3)

  firstSeenAt DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)

  previousLoginAt DateTime? @map("previous_login_at") @db.Timestamptz(3)

  lastActiveAt DateTime? @map("last_active_at") @db.Timestamptz(3)

  previousActiveAt DateTime? @map("previous_active_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  grants       ModuleGrant[] @relation("EmployeeGrants")
  grantsIssued ModuleGrant[] @relation("GrantIssuedBy")

  auditEventsActed    AuditEvent[] @relation("AuditActor")
  auditEventsTargeted AuditEvent[] @relation("AuditTarget")

  draftLocks DraftLock[]

  basCredentialsUpdated BasStationCredential[] @relation("BasCredentialUpdatedBy")

  syncsTriggered CipSkillSync[]
  workflowsCreated CipWorkflow[]
  projectSyncsTriggered CipProjectSync[]
  runsStarted      CipRun[]
  checkpointsAnswered CipRunCheckpoint[]

  fpProjectsCreated   FpProject[]   @relation("FpProjectCreatedBy")
  fpProjectsCompleted FpProject[]   @relation("FpProjectCompletedBy")
  fpProjectsReviewed  FpProject[]   @relation("FpProjectReviewedBy")
  fpEquipmentUpdated  FpEquipment[] @relation("FpEquipmentUpdatedBy")

  kbConversations  KbConversation[] @relation("KbConversations")
  kbSyncsTriggered KbSyncRun[]      @relation("KbSyncTriggeredBy")
  kbReportsFiled   KbAnswerReport[] @relation("KbAnswerReportsFiled")
  kbReportsResolved KbAnswerReport[] @relation("KbAnswerReportsResolved")

  @@index([status])
  @@index([departmentId])
  @@index([positionId])
  @@map("employees")
}

/// The module registry; drives the sidebar and the admin grant matrix.
model Module {
  key         String       @id
  displayName String       @map("display_name")
  description String?
  icon        String?
  sortOrder   Int          @map("sort_order")
  status      ModuleStatus @default(active)

  grants ModuleGrant[]

  @@index([status, sortOrder])
  @@map("modules")
}

/// One employee's access to one module, with an optional module-admin flag.
model ModuleGrant {
  id String @id @default(uuid()) @db.Uuid

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation("EmployeeGrants", fields: [employeeId], references: [id], onDelete: Cascade)

  moduleKey String @map("module_key")
  module    Module @relation(fields: [moduleKey], references: [key], onDelete: Cascade)

  isModuleAdmin Boolean @default(false) @map("is_module_admin")

  grantedById String?   @map("granted_by_id") @db.Uuid
  grantedBy   Employee? @relation("GrantIssuedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  @@unique([employeeId, moduleKey])
  @@index([moduleKey])
  @@map("module_grants")
}

/// A job title employees pick during onboarding.
model Position {
  id     String         @id @default(uuid()) @db.Uuid
  name   String         @unique
  status ListItemStatus @default(active)

  employees Employee[]

  @@map("positions")
}

/// A department admins assign to employees.
model Department {
  id     String         @id @default(uuid()) @db.Uuid
  name   String         @unique
  status ListItemStatus @default(active)

  employees Employee[]

  @@map("departments")
}

/// Advisory lock so two people do not edit the same mail draft at once.
model DraftLock {
  messageId String @id @map("message_id")

  heldById String   @map("held_by_id") @db.Uuid
  heldBy   Employee @relation(fields: [heldById], references: [id], onDelete: Cascade)

  acquiredAt DateTime @default(now()) @map("acquired_at") @db.Timestamptz(3)

  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@index([heldById])
  @@map("draft_locks")
}

/// Append-only record of who did what, enforced by a database trigger.
model AuditEvent {
  id String @id @default(uuid()) @db.Uuid

  actorEmployeeId String?   @map("actor_employee_id") @db.Uuid
  actor           Employee? @relation("AuditActor", fields: [actorEmployeeId], references: [id], onDelete: SetNull)

  action String

  targetEmployeeId String?   @map("target_employee_id") @db.Uuid
  target           Employee? @relation("AuditTarget", fields: [targetEmployeeId], references: [id], onDelete: SetNull)

  moduleKey String? @map("module_key")

  metadata Json?

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([targetEmployeeId, occurredAt])
  @@index([actorEmployeeId, occurredAt])
  @@index([action, occurredAt])
  @@index([occurredAt])
  @@map("audit_events")
}

/// Controlled vocabulary of equipment kinds (AHU, VAV, chiller).
model BasEquipmentType {
  equipType   String @id @map("equip_type")
  displayName String @map("display_name")
  description String

  category String

  equipment BasEquipment[]

  @@map("bas_equipment_types")
}

/// Controlled vocabulary of what kind of measurement a point is.
model BasPointRole {
  pointRole   String @id @map("point_role")
  displayName String @map("display_name")
  description String

  measurement String?
  typicalUnit String? @map("typical_unit")

  isSetpoint Boolean @default(false) @map("is_setpoint")
  isCommand  Boolean @default(false) @map("is_command")
  isStatus   Boolean @default(false) @map("is_status")

  setpointFor     String?        @map("setpoint_for")
  setpointForRole BasPointRole?  @relation("BasRoleSetpointFor", fields: [setpointFor], references: [pointRole], onDelete: Restrict)
  setpointForBy   BasPointRole[] @relation("BasRoleSetpointFor")

  statusOf     String?        @map("status_of")
  statusOfRole BasPointRole?  @relation("BasRoleStatusOf", fields: [statusOf], references: [pointRole], onDelete: Restrict)
  statusOfBy   BasPointRole[] @relation("BasRoleStatusOf")

  points BasPoint[]

  @@map("bas_point_roles")
}

/// The customer or business unit that owns a set of buildings.
model BasOrg {
  orgId     BigInt    @id @default(autoincrement()) @map("org_id")
  name      String    @unique
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  projects BasProject[]
  sites    BasSite[]

  @@map("bas_orgs")
}

/// A property or campus that groups several buildings.
model BasProject {
  projectId BigInt @id @default(autoincrement()) @map("project_id")

  orgId BigInt @map("org_id")
  org   BasOrg @relation(fields: [orgId], references: [orgId], onDelete: Restrict)

  name      String
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  sites BasSite[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("bas_projects")
}

/// A building.
model BasSite {
  siteId BigInt @id @default(autoincrement()) @map("site_id")

  orgId BigInt @map("org_id")
  org   BasOrg @relation(fields: [orgId], references: [orgId], onDelete: Restrict)

  projectId BigInt     @map("project_id")
  project   BasProject @relation(fields: [projectId], references: [projectId], onDelete: Restrict)

  name    String
  address String?

  timezone String

  areaSqft Int? @map("area_sqft")

  attributes Json @default("{}")

  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  stations  BasStation[]
  equipment BasEquipment[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("bas_sites")
}

/// A Niagara station (JACE or Supervisor); one row per controller.
model BasStation {
  stationId BigInt @id @default(autoincrement()) @map("station_id")

  siteId BigInt  @map("site_id")
  site   BasSite @relation(fields: [siteId], references: [siteId], onDelete: Restrict)

  displayName String? @map("display_name")

  niagaraStationName String @map("niagara_station_name")

  connectionMode String @default("via_parent") @map("connection_mode")

  baseUrl        String? @map("base_url")

  tlsSha256 String? @map("tls_sha256")

  hostId         String? @map("host_id")
  model          String?
  niagaraVersion String? @map("niagara_version")

  clockOffsetS    Int?      @map("clock_offset_s")
  clockMeasuredAt DateTime? @map("clock_measured_at") @db.Timestamptz()

  parentStationId BigInt?      @map("parent_station_id")
  parentStation   BasStation?  @relation("BasStationParent", fields: [parentStationId], references: [stationId], onDelete: Restrict)
  childStations   BasStation[] @relation("BasStationParent")

  isActive    Boolean   @default(true) @map("is_active")
  notes       String?
  firstSeenAt DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz()
  lastSeenAt  DateTime? @map("last_seen_at") @db.Timestamptz()

  points     BasPoint[]
  ingestRuns BasIngestRun[]
  credential BasStationCredential?

  @@unique([siteId, niagaraStationName])
  @@index([siteId])
  @@map("bas_stations")
}

/// The encrypted Niagara login the collector uses for one station.
model BasStationCredential {
  stationId BigInt @id @map("station_id")

  station BasStation @relation(fields: [stationId], references: [stationId], onDelete: Cascade)

  username String

  passwordCiphertext String @map("password_ciphertext")

  keyVersion Int @map("key_version")

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  updatedById String?   @map("updated_by") @db.Uuid
  updatedBy   Employee? @relation("BasCredentialUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
  @@map("bas_station_credentials")
}

/// A physical piece of equipment, such as AHU-3 or VAV-204.
model BasEquipment {
  equipmentId BigInt @id @default(autoincrement()) @map("equipment_id")

  siteId BigInt  @map("site_id")
  site   BasSite @relation(fields: [siteId], references: [siteId], onDelete: Restrict)

  name String

  equipType     String?           @map("equip_type")
  equipmentType BasEquipmentType? @relation(fields: [equipType], references: [equipType], onDelete: Restrict)

  parentEquipmentId BigInt?        @map("parent_equipment_id")
  parentEquipment   BasEquipment?  @relation("BasEquipmentParent", fields: [parentEquipmentId], references: [equipmentId], onDelete: Restrict)
  childEquipment    BasEquipment[] @relation("BasEquipmentParent")

  attributes Json     @default("{}")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  points BasPoint[]

  @@unique([siteId, name])
  @@index([siteId])
  @@index([equipType])
  @@index([parentEquipmentId])
  @@map("bas_equipment")
}

/// One trended value in a building, keyed by station and Niagara history name.
model BasPoint {
  pointId BigInt @id @default(autoincrement()) @map("point_id")

  stationId BigInt     @map("station_id")
  station   BasStation @relation(fields: [stationId], references: [stationId], onDelete: Restrict)

  equipmentId BigInt?       @map("equipment_id")
  equipment   BasEquipment? @relation(fields: [equipmentId], references: [equipmentId], onDelete: Restrict)

  niagaraHistoryName String  @map("niagara_history_name")
  niagaraHistoryOrd  String? @map("niagara_history_ord")

  niagaraDisplayName String? @map("display_name")

  label String?

  isVisible Boolean @default(true) @map("is_visible")

  pointRole String?       @map("point_role")
  role      BasPointRole? @relation(fields: [pointRole], references: [pointRole], onDelete: Restrict)

  unit String?

  dataType       String  @default("unknown") @map("data_type")
  sourceTimezone String? @map("source_timezone")

  collectionIntervalS Int? @map("collection_interval_s")

  capacity Int?

  fullPolicy String? @map("full_policy")

  rollHorizonS Int? @map("roll_horizon_s")

  tags  Json    @default("{}")
  notes String?

  isActive    Boolean   @default(true) @map("is_active")

  inactiveReason String? @map("inactive_reason")

  firstSeenAt DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz()
  lastSeenAt  DateTime? @map("last_seen_at") @db.Timestamptz()

  readings   BasReading[]
  checkpoint BasSyncCheckpoint?
  gaps       BasDataGap[]
  linksFrom  BasPointLink[]     @relation("BasLinkFrom")
  linksTo    BasPointLink[]     @relation("BasLinkTo")

  @@unique([stationId, niagaraHistoryName])
  @@index([stationId])
  @@index([equipmentId])
  @@index([pointRole])
  @@index([isActive])
  @@map("bas_points")
}

/// One trend record; append-only, never updated or deleted.
model BasReading {
  pointId BigInt   @map("point_id")
  point   BasPoint @relation(fields: [pointId], references: [pointId], onDelete: Cascade)

  ts DateTime @db.Timestamptz()

  valueNum  Float?   @map("value_num")
  valueBool Boolean? @map("value_bool")
  valueStr  String?  @map("value_str")

  status String?

  @@id([pointId, ts])
  @@index([ts], type: Brin)
  @@map("bas_readings")
}

/// An explicit relationship between two points the role vocabulary cannot infer.
model BasPointLink {
  fromPointId BigInt   @map("from_point_id")
  fromPoint   BasPoint @relation("BasLinkFrom", fields: [fromPointId], references: [pointId], onDelete: Cascade)

  toPointId BigInt   @map("to_point_id")
  toPoint   BasPoint @relation("BasLinkTo", fields: [toPointId], references: [pointId], onDelete: Cascade)

  linkType String @map("link_type")

  confidence String @default("manual")

  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@id([fromPointId, toPointId, linkType])
  @@index([toPointId])
  @@map("bas_point_links")
}

/// Per-point collector high-water mark and completeness verdict.
model BasSyncCheckpoint {
  pointId BigInt   @id @map("point_id")
  point   BasPoint @relation(fields: [pointId], references: [pointId], onDelete: Cascade)

  lastRecordTs DateTime? @map("last_record_ts") @db.Timestamptz()
  lastRunAt    DateTime? @map("last_run_at") @db.Timestamptz()

  lastStatus          String  @default("never_run") @map("last_status")
  consecutiveFailures Int     @default(0) @map("consecutive_failures")
  lastError           String? @map("last_error")

  completeness          String    @default("unknown")
  completenessCheckedAt DateTime? @map("completeness_checked_at") @db.Timestamptz()
  completenessNote      String?   @map("completeness_note")

  stationCount Int?      @map("station_count")
  stationStart DateTime? @map("station_start") @db.Timestamptz()
  stationEnd   DateTime? @map("station_end") @db.Timestamptz()
  heldCount    Int?      @map("held_count")

  observedSpanS Int? @map("observed_span_s")

  shortestFullSpanS Int? @map("shortest_full_span_s")

  @@map("bas_sync_checkpoints")
}

/// One row per collector run, with its status and counts.
model BasIngestRun {
  runId BigInt @id @default(autoincrement()) @map("run_id")

  stationId BigInt?     @map("station_id")
  station   BasStation? @relation(fields: [stationId], references: [stationId], onDelete: Restrict)

  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz()
  finishedAt DateTime? @map("finished_at") @db.Timestamptz()

  status String @default("running")

  windowStart DateTime? @map("window_start") @db.Timestamptz()
  windowEnd   DateTime? @map("window_end") @db.Timestamptz()

  pointsAttempted Int @default(0) @map("points_attempted")
  pointsSucceeded Int @default(0) @map("points_succeeded")
  recordsWritten  Int @default(0) @map("records_written")

  pointsIncomplete  Int @default(0) @map("points_incomplete")
  pointsBackfilling Int @default(0) @map("points_backfilling")

  errors Json @default("[]")

  collectorVersion String? @map("collector_version")
  collectorHost    String? @map("collector_host")

  @@index([startedAt(sort: Desc)])
  @@map("bas_ingest_runs")
}

/// A period of known missing data for a point, and why.
model BasDataGap {
  gapId BigInt @id @default(autoincrement()) @map("gap_id")

  pointId BigInt   @map("point_id")
  point   BasPoint @relation(fields: [pointId], references: [pointId], onDelete: Cascade)

  gapStart   DateTime @map("gap_start") @db.Timestamptz()
  gapEnd     DateTime @map("gap_end") @db.Timestamptz()
  detectedAt DateTime @default(now()) @map("detected_at") @db.Timestamptz()

  cause String

  notes String?

  @@unique([pointId, gapStart, cause])
  @@index([pointId, gapStart])
  @@map("bas_data_gaps")
}

/// A record of all claude skills for the cost intelligence platform
model CipSkill {
  id           BigInt   @id @default(autoincrement())
  name         String
  description  String
  version      Int
  locationPath String   @map("location_path")
  folderName   String   @unique @map("folder_name")
  lastModified DateTime @map("last_modified") @db.Timestamptz(3)
  lastSynced   DateTime @map("last_synced") @db.Timestamptz(3)

  @@map("cip_skills")
}

/// A record of all syncs triggered for claude skills in the cost intelligence platform
model CipSkillSync {
  id            BigInt    @id @default(autoincrement())
  trigger       String
  triggeredById String?   @map("triggered_by_id") @db.Uuid
  triggeredBy   Employee? @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  status        String    @default("running")
  skillsSeen    Int       @default(0) @map("skills_seen")
  skillsAdded   Int       @default(0) @map("skills_added")
  skillsUpdated Int       @default(0) @map("skills_updated")
  skillsDeleted Int       @default(0) @map("skills_deleted")
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(3)
  errors        Json      @default("[]")

  @@index([startedAt(sort: Desc)])
  @@map("cip_skill_syncs")
}

/// A named, ordered list of skills that a run executes; built by PCEs in Settings
model CipWorkflow {
  id          BigInt    @id @default(autoincrement())
  name        String
  description String?
  status      String    @default("draft")
  createdById String?   @map("created_by_id") @db.Uuid
  createdBy   Employee? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  steps CipWorkflowStep[]
  runs  CipRun[]

  @@map("cip_workflows")
}

/// One skill in a workflow, stored by folder name so a skill gone from the folder shows as missing instead of blocking sync
model CipWorkflowStep {
  id              BigInt      @id @default(autoincrement())
  workflowId      BigInt      @map("workflow_id")
  workflow        CipWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  position        Int
  skillFolderName String      @map("skill_folder_name")

  @@unique([workflowId, position])
  @@unique([workflowId, skillFolderName])
  @@map("cip_workflow_steps")
}

/// A project folder in BID-DOC; metadata only, the files themselves are read at run time
model CipProject {
  id           BigInt    @id @default(autoincrement())
  folderName   String    @unique @map("folder_name")
  locationPath String    @map("location_path")
  categories   String[]  @default([])
  fileCount    Int       @map("file_count")
  totalBytes   BigInt    @map("total_bytes")
  lastModified DateTime? @map("last_modified") @db.Timestamptz(3)
  aiFileCount  Int?      @map("ai_file_count")
  lastSynced   DateTime  @map("last_synced") @db.Timestamptz(3)
  removedAt    DateTime? @map("removed_at") @db.Timestamptz(3)
  /// The file tree as of the last sync: { tree, truncated }. Null until the next sync.
  fileTree     Json?     @map("file_tree")

  runs CipRun[]

  @@map("cip_projects")
}

/// A record of every project sync, manual or scheduled
model CipProjectSync {
  id              BigInt    @id @default(autoincrement())
  trigger         String
  triggeredById   String?   @map("triggered_by_id") @db.Uuid
  triggeredBy     Employee? @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  status          String    @default("running")
  projectsSeen    Int       @default(0) @map("projects_seen")
  projectsAdded   Int       @default(0) @map("projects_added")
  projectsUpdated Int       @default(0) @map("projects_updated")
  projectsRemoved Int       @default(0) @map("projects_removed")
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz(3)
  errors          Json      @default("[]")

  @@index([startedAt(sort: Desc)])
  @@map("cip_project_syncs")
}

/// One execution of a workflow against a project. Also the job queue: the worker claims `queued` runs
model CipRun {
  id            BigInt       @id @default(autoincrement())
  workflowId    BigInt?      @map("workflow_id")
  workflow      CipWorkflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  workflowName  String       @map("workflow_name")
  projectId     BigInt       @map("project_id")
  project       CipProject   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  steps         Json
  status        String       @default("queued")
  currentStep   Int          @default(0) @map("current_step")
  sessionId     String?      @map("session_id")
  /// Set by Continue: what the worker resumes the session with, once
  resumePrompt  String?      @map("resume_prompt")
  model         String
  budgetUsd     Decimal      @map("budget_usd") @db.Decimal(10, 2)
  costUsd       Decimal      @default(0) @map("cost_usd") @db.Decimal(12, 6)
  inputTokens   BigInt       @default(0) @map("input_tokens")
  outputTokens  BigInt       @default(0) @map("output_tokens")
  error         String?
  startedById   String?      @map("started_by_id") @db.Uuid
  startedBy     Employee?    @relation(fields: [startedById], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt     DateTime?    @map("started_at") @db.Timestamptz(3)
  heartbeatAt   DateTime?    @map("heartbeat_at") @db.Timestamptz(3)
  finishedAt    DateTime?    @map("finished_at") @db.Timestamptz(3)

  events      CipRunEvent[]
  checkpoints CipRunCheckpoint[]
  transcripts CipRunTranscript[]

  @@index([createdAt(sort: Desc)])
  @@index([status])
  @@map("cip_runs")
}

/// The run ledger: append-only, one row per thing that happened, outputs included
model CipRunEvent {
  id      BigInt   @id @default(autoincrement())
  runId   BigInt   @map("run_id")
  run     CipRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  step    Int?
  type    String
  message String
  data    Json     @default("{}")
  at      DateTime @default(now()) @db.Timestamptz(3)

  @@index([runId, id])
  @@map("cip_run_events")
}

/// A question a skill asked a person mid-run; the run waits until it is answered
model CipRunCheckpoint {
  id           BigInt    @id @default(autoincrement())
  runId        BigInt    @map("run_id")
  run          CipRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  step         Int
  question     String
  options      Json      @default("[]")
  answer       String?
  answeredById String?   @map("answered_by_id") @db.Uuid
  answeredBy   Employee? @relation(fields: [answeredById], references: [id], onDelete: SetNull)
  askedAt      DateTime  @default(now()) @map("asked_at") @db.Timestamptz(3)
  answeredAt   DateTime? @map("answered_at") @db.Timestamptz(3)

  @@index([runId])
  @@map("cip_run_checkpoints")
}

/// The Agent SDK session transcript, mirrored here so a paused run can resume in a fresh container
model CipRunTranscript {
  id        BigInt @id @default(autoincrement())
  runId     BigInt @map("run_id")
  run       CipRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  sessionId String @map("session_id")
  subpath   String @default("")
  entryUuid String? @map("entry_uuid")
  entry     Json

  @@index([runId, sessionId, subpath, id])
  @@map("cip_run_transcripts")
}

// ---------------------------------------------------------------------------
// Freeze Protection (fp_). Entered by hand in the platform, so the platform is
// the source of truth and stores everything. A project is verified once: its
// verification (date, signoff, transmittal) is on the project and each unit's
// results are on its equipment row. History is the audit log (append-only,
// timestamped), not a second copy here. Closed vocabularies are text with
// CHECK constraints in the migration, matching lib/modules/freeze-protection/types.ts.
// ---------------------------------------------------------------------------

/// A construction job and its one freeze protection verification. Not linked to BAS or any other module
model FpProject {
  id               BigInt    @id @default(autoincrement())
  jobNumber        String    @map("job_number")
  name             String
  /// The date the report speaks for. Equipment brought online after it is not covered
  verificationDate DateTime  @map("verification_date") @db.Date
  completedById    String?   @map("completed_by_id") @db.Uuid
  completedBy      Employee? @relation("FpProjectCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(3)
  reviewedById     String?   @map("reviewed_by_id") @db.Uuid
  reviewedBy       Employee? @relation("FpProjectReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamptz(3)
  transmittedTo    String?   @map("transmitted_to")
  transmittedDate  DateTime? @map("transmitted_date") @db.Date
  createdById      String?   @map("created_by_id") @db.Uuid
  createdBy        Employee? @relation("FpProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  equipment FpEquipment[]

  @@map("fp_projects")
}

/// One unit from the mechanical equipment schedule and its verification results (status, steps 2 to 6). Null means not answered yet
model FpEquipment {
  id                    BigInt    @id @default(autoincrement())
  projectId             BigInt    @map("project_id")
  project               FpProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                  String
  equipmentType         String?   @map("equipment_type")
  areaServed            String?   @map("area_served")
  sortOrder             Int       @default(0) @map("sort_order")
  status                String    @default("service")
  coil                  String?
  exposure              String?
  protection            String?
  testFanStops          String?   @map("test_fan_stops")
  testDamperCloses      String?   @map("test_damper_closes")
  testValveFullFlow     String?   @map("test_valve_full_flow")
  testManualReset       String?   @map("test_manual_reset")
  tripTempF             Float?    @map("trip_temp_f")
  testedBy              String?   @map("tested_by")
  testDate              DateTime? @map("test_date") @db.Date
  elements              String?
  notifyWho             String?   @map("notify_who")
  notifyDate            DateTime? @map("notify_date") @db.Date
  notifyMethod          String?   @map("notify_method")
  notifyResponse        String?   @map("notify_response")
  deficiencyDescription String?   @map("deficiency_description")
  deficiencyOwner       String?   @map("deficiency_owner")
  deficiencyDue         DateTime? @map("deficiency_due") @db.Date
  documentedWith        String?   @map("documented_with")
  documentedName        String?   @map("documented_name")
  documentedDate        DateTime? @map("documented_date") @db.Date
  documentedMethod      String?   @map("documented_method")
  notes                 String?
  updatedById           String?   @map("updated_by_id") @db.Uuid
  updatedBy             Employee? @relation("FpEquipmentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([projectId])
  @@map("fp_equipment")
}

// ---------------------------------------------------------------------------
// Knowledge Base (module 4) - Phase 1 schema, 2026-10-27
//
// Two kinds of table, with different owners, and the difference matters:
//
//   THE INDEX (kb_projects, kb_documents, kb_chunks, kb_sync_runs) is DERIVED
//   from the SharePoint legacy projects folder. SharePoint is the source of
//   truth; these can be truncated and rebuilt by re-running the sync with no
//   loss (docs/05-database-and-sources.md). Never store an original file.
//
//   THE HISTORY (kb_conversations, kb_questions, kb_question_sources,
//   kb_answer_reports) is the PLATFORM's own record of what it told an
//   employee, kept centrally and indefinitely. It survives a rebuild
//   of the index: each question keeps a snapshot of the answer and its
//   sources, and its links into the index go NULL rather than vanish.
//
// Half of this is invisible to Prisma, like the BAS views and CHECKs: the
// pgvector column, the HNSW index, the tsvector trigger, the partial unique
// index and every CHECK live only in the migration SQL. Prisma cannot express
// HNSW, so the next `prisma migrate dev` will try to DROP it; delete that line.
// tests/kb-schema.test.ts fails on it. docs/KB-P0-P1.md.
// ---------------------------------------------------------------------------

/// `local` is a developer's synced copy of the folder (KB_LOCAL_SOURCE_DIR);
/// production only ever holds `sharepoint` rows.
enum KbSourceKind {
  sharepoint
  local
}

/// `pending` seen, not yet processed; `indexed` has its chunks; `skipped`
/// deliberately left out (see `skip_reason`); `failed` attempted (see `error`).
enum KbDocumentStatus {
  pending
  indexed
  skipped
  failed
}

enum KbSyncRunStatus {
  /// Asked for (the admin's Index button), waiting for the worker job.
  queued
  running
  ok
  partial
  failed
}

/// One project folder under the legacy projects root.
model KbProject {
  id String @id @default(uuid()) @db.Uuid

  sourceKind KbSourceKind @map("source_kind")
  /// Graph driveItem id for `sharepoint`, folder name for `local`.
  sourceId String @map("source_id")

  /// The folder as named, e.g. `221457_MAGNODE`.
  folderName String @map("folder_name")
  /// Six-digit job number from `[JOB]_[NAME]`, null when the folder does not
  /// follow the template.
  projectNumber String? @map("project_number")
  /// Readable name from the folder, e.g. `Magnode`. Display only.
  name   String
  webUrl String? @map("web_url")

  /// Only legacy projects are searchable. Set by the sync from the legacy rule
  /// (still to be confirmed, docs/KB-P0-P1.md); a project that stops being
  /// legacy keeps its rows but drops out of search.
  isLegacy Boolean @default(false) @map("is_legacy")

  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  documents KbDocument[]

  @@unique([sourceKind, sourceId])
  @@index([projectNumber])
  @@map("kb_projects")
}

/// One file in a project folder, indexed or not. Skipped files get a row too,
/// so "why can't search find X" is a query rather than a guess.
model KbDocument {
  id String @id @default(uuid()) @db.Uuid

  projectId String    @map("project_id") @db.Uuid
  project   KbProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sourceKind KbSourceKind @map("source_kind")
  /// Graph driveItem id for `sharepoint` (survives renames), path for `local`.
  sourceId String @map("source_id")

  /// Path below the project folder, e.g. `11 - SUBMITTALS/221457_SUB_Fans_Approved_20220120.pdf`.
  path     String
  fileName String @map("file_name")
  /// Lower-case extension without the dot. Chooses the extractor.
  fileType String @map("file_type")

  /// The link a citation opens. SharePoint applies the reader's OWN
  /// permissions on click; the platform never serves the file.
  webUrl String? @map("web_url")

  etag             String?
  contentSha256    String?   @map("content_sha256")
  sizeBytes        BigInt?   @map("size_bytes")
  sourceModifiedAt DateTime? @map("source_modified_at") @db.Timestamptz(3)

  /// The template folder code the file sits under: `11`, `2B`, `5C`.
  folderCode String? @map("folder_code")

  /// Versions of one document share a family: same project, folder and
  /// description, differing only in the `_vNN` or `_YYYYMMDD` suffix. Answers
  /// prefer `is_latest` and surface older ones only to explain a change.
  familyKey    String  @map("family_key")
  versionLabel String? @map("version_label")
  isLatest     Boolean @default(true) @map("is_latest")
  /// An `ARCHIVE_` file: superseded or rejected. Indexed, so an answer can
  /// explain a change, but never the latest (CHECK).
  isArchived   Boolean @default(false) @map("is_archived")

  status KbDocumentStatus @default(pending)
  /// CHECK: one of KB_SKIP_REASONS (scope.ts); present exactly when skipped.
  skipReason String? @map("skip_reason")
  /// Present exactly when failed (CHECK).
  error      String?
  chunkCount Int     @default(0) @map("chunk_count")

  /// The model that embedded this document's chunks. A different configured
  /// model means every vector must be rebuilt.
  embeddingModel String?   @map("embedding_model")
  indexedAt      DateTime? @map("indexed_at") @db.Timestamptz(3)

  /// Stamped by every sync that sees the file. A completed sync that did not
  /// see it means it was deleted or moved out.
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  chunks          KbChunk[]
  questionSources KbQuestionSource[]

  @@unique([sourceKind, sourceId])
  @@index([projectId, familyKey])
  @@index([status])
  @@map("kb_documents")
}

/// A passage: the unit that is embedded, searched and cited. Written with raw
/// SQL, because Prisma cannot write `embedding` or `content_tsv`.
model KbChunk {
  id String @id @default(uuid()) @db.Uuid

  documentId String     @map("document_id") @db.Uuid
  document   KbDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// 0-based within the document; a re-index replaces rather than appends.
  ordinal Int
  content String

  /// The most precise location the format gave, and never more. Any of these
  /// may be null; the screen says "location not available" rather than guess.
  /// PDF: page range. Word/Markdown: section. Excel: sheet and cell range.
  pageStart Int?    @map("page_start")
  pageEnd   Int?    @map("page_end")
  section   String?
  sheet     String?
  /// A1-style range on `sheet`, e.g. `B4:F12`.
  cellRange String? @map("cell_range")

  tokenCount Int? @map("token_count")

  /// vector(1536). NULL between extraction and embedding, so a sync can resume.
  embedding      Unsupported("vector(1536)")?
  embeddingModel String?                      @map("embedding_model")

  /// Kept by the kb_chunks_tsv trigger from section, sheet and content.
  contentTsv Unsupported("tsvector")? @map("content_tsv")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  questionSources KbQuestionSource[]

  @@unique([documentId, ordinal])
  @@index([contentTsv], type: Gin)
  @@map("kb_chunks")
}

/// One sync, run by a person (`npm run kb:sync`) or, from Phase 7, by the
/// scheduled job. At most one runs at a time (partial unique index).
model KbSyncRun {
  id String @id @default(uuid()) @db.Uuid

  sourceKind KbSourceKind    @map("source_kind")
  status     KbSyncRunStatus @default(running)

  /// CHECK: 'manual' or 'scheduled'.
  trigger       String
  triggeredById String?   @map("triggered_by_id") @db.Uuid
  triggeredBy   Employee? @relation("KbSyncTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)

  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)
  /// Last sign of life from a running sync; silent for ten minutes is abandoned.
  heartbeatAt DateTime? @map("heartbeat_at") @db.Timestamptz(3)

  embeddingModel String? @map("embedding_model")

  projectsSeen   Int @default(0) @map("projects_seen")
  filesSeen      Int @default(0) @map("files_seen")
  filesIndexed   Int @default(0) @map("files_indexed")
  filesUnchanged Int @default(0) @map("files_unchanged")
  filesSkipped   Int @default(0) @map("files_skipped")
  filesFailed    Int @default(0) @map("files_failed")
  filesRemoved   Int @default(0) @map("files_removed")
  chunksWritten  Int @default(0) @map("chunks_written")
  /// Passages this sync gave a vector to, and the tokens Azure counted for them.
  chunksEmbedded  Int @default(0) @map("chunks_embedded")
  embeddingTokens Int @default(0) @map("embedding_tokens")

  error String?

  @@index([startedAt(sort: Desc)])
  @@map("kb_sync_runs")
}

/// A thread of questions and follow-ups by one employee. History is compact:
/// questions and final answers, never a transcript.
model KbConversation {
  id String @id @default(uuid()) @db.Uuid

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation("KbConversations", fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// The last question's time; the history list sorts on it.
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  questions KbQuestion[]

  @@index([employeeId, updatedAt(sort: Desc)])
  @@map("kb_conversations")
}

/// One question and its final answer.
model KbQuestion {
  id String @id @default(uuid()) @db.Uuid

  conversationId String         @map("conversation_id") @db.Uuid
  conversation   KbConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// 0 for the first question, 1.. for follow-ups. Unique per conversation.
  ordinal  Int
  question String

  /// The projects searched, and how they were chosen. CHECK on scope_how:
  /// 'all', 'chosen', 'from_question', 'follow_up'. Ids of kb_projects at the
  /// time; a rebuilt index may no longer hold them, which is why the answer
  /// snapshot carries names too.
  scopeProjectIds String[] @map("scope_project_ids") @db.Uuid
  scopeHow        String   @map("scope_how")

  /// CHECK: 'answered' or 'no_evidence'.
  answerKind String @map("answer_kind")
  /// The answer exactly as shown, sources included: the platform's record of
  /// what it said, readable after the index has been rebuilt.
  answer     Json

  /// Which Claude model wrote it, and how long the whole question took.
  model      String?
  durationMs Int?    @map("duration_ms")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sources KbQuestionSource[]
  reports KbAnswerReport[]

  @@unique([conversationId, ordinal])
  @@map("kb_questions")
}

/// One numbered citation in an answer, linked back into the index so an
/// admin can ask "which answers cited this document". The links go NULL when
/// the index is rebuilt; the answer snapshot on kb_questions stays complete.
model KbQuestionSource {
  questionId String     @map("question_id") @db.Uuid
  question   KbQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  /// The citation number as shown, 1-based.
  n Int

  documentId String?     @map("document_id") @db.Uuid
  document   KbDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  chunkId    String?     @map("chunk_id") @db.Uuid
  chunk      KbChunk?    @relation(fields: [chunkId], references: [id], onDelete: SetNull)

  @@id([questionId, n])
  @@index([documentId])
  @@map("kb_question_sources")
}

/// An employee's report that an answer is wrong. The platform admin works the
/// queue: each report is open until someone resolves or dismisses it, with a
/// note saying what was found. One open report per person per question.
model KbAnswerReport {
  id String @id @default(uuid()) @db.Uuid

  questionId String     @map("question_id") @db.Uuid
  question   KbQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  reportedById String?   @map("reported_by_id") @db.Uuid
  reportedBy   Employee? @relation("KbAnswerReportsFiled", fields: [reportedById], references: [id], onDelete: SetNull)

  /// CHECK: one of KB_REPORT_REASONS (lib/modules/knowledge-base/types.ts).
  reason String
  /// The citation number the report is about, when it is about one.
  citationN Int?    @map("citation_n")
  /// In the reporter's words. Up to 2,000 characters (CHECK).
  comment   String?

  /// CHECK: 'open', 'resolved' or 'dismissed'. Resolver, note and time are
  /// present exactly when it is no longer open.
  status         String    @default("open")
  resolvedById   String?   @map("resolved_by_id") @db.Uuid
  resolvedBy     Employee? @relation("KbAnswerReportsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNote String?   @map("resolution_note")
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt(sort: Desc)])
  @@index([questionId])
  @@map("kb_answer_reports")
}
