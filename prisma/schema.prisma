generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmployeeStatus {
  active
  disabled
}

enum ModuleStatus {
  active
  hidden
}

enum ListItemStatus {
  active
  hidden
}

/// A company employee, created on first Entra sign-in and never by an admin.
model Employee {
  id String @id @default(uuid()) @db.Uuid

  entraOid String? @unique @map("entra_oid")

  email     String @unique
  firstName String @map("first_name")
  lastName  String @map("last_name")

  positionId String?   @map("position_id") @db.Uuid
  position   Position? @relation(fields: [positionId], references: [id], onDelete: Restrict)

  positionOther String? @map("position_other")

  departmentId String?     @map("department_id") @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  profileCompleted Boolean        @default(false) @map("profile_completed")
  status           EmployeeStatus @default(active)
  isPlatformAdmin  Boolean        @default(false) @map("is_platform_admin")

  sessionsValidAfter DateTime? @map("sessions_valid_after") @db.Timestamptz(3)

  firstSeenAt DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)

  previousLoginAt DateTime? @map("previous_login_at") @db.Timestamptz(3)

  lastActiveAt DateTime? @map("last_active_at") @db.Timestamptz(3)

  previousActiveAt DateTime? @map("previous_active_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  grants       ModuleGrant[] @relation("EmployeeGrants")
  grantsIssued ModuleGrant[] @relation("GrantIssuedBy")

  auditEventsActed    AuditEvent[] @relation("AuditActor")
  auditEventsTargeted AuditEvent[] @relation("AuditTarget")

  draftLocks DraftLock[]

  basCredentialsUpdated BasStationCredential[] @relation("BasCredentialUpdatedBy")

  syncsTriggered CipSkillSync[]
  workflowsCreated CipWorkflow[]
  projectSyncsTriggered CipProjectSync[]
  runsStarted      CipRun[]
  checkpointsAnswered CipRunCheckpoint[]

  fpProjectsCreated      FpProject[]      @relation("FpProjectCreatedBy")
  fpVerificationsCreated FpVerification[] @relation("FpVerificationCreatedBy")
  fpVerificationsCompleted FpVerification[] @relation("FpVerificationCompletedBy")
  fpVerificationsReviewed  FpVerification[] @relation("FpVerificationReviewedBy")
  fpResultsUpdated       FpResult[]       @relation("FpResultUpdatedBy")

  @@index([status])
  @@index([departmentId])
  @@index([positionId])
  @@map("employees")
}

/// The module registry; drives the sidebar and the admin grant matrix.
model Module {
  key         String       @id
  displayName String       @map("display_name")
  description String?
  icon        String?
  sortOrder   Int          @map("sort_order")
  status      ModuleStatus @default(active)

  grants ModuleGrant[]

  @@index([status, sortOrder])
  @@map("modules")
}

/// One employee's access to one module, with an optional module-admin flag.
model ModuleGrant {
  id String @id @default(uuid()) @db.Uuid

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation("EmployeeGrants", fields: [employeeId], references: [id], onDelete: Cascade)

  moduleKey String @map("module_key")
  module    Module @relation(fields: [moduleKey], references: [key], onDelete: Cascade)

  isModuleAdmin Boolean @default(false) @map("is_module_admin")

  grantedById String?   @map("granted_by_id") @db.Uuid
  grantedBy   Employee? @relation("GrantIssuedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  @@unique([employeeId, moduleKey])
  @@index([moduleKey])
  @@map("module_grants")
}

/// A job title employees pick during onboarding.
model Position {
  id     String         @id @default(uuid()) @db.Uuid
  name   String         @unique
  status ListItemStatus @default(active)

  employees Employee[]

  @@map("positions")
}

/// A department admins assign to employees.
model Department {
  id     String         @id @default(uuid()) @db.Uuid
  name   String         @unique
  status ListItemStatus @default(active)

  employees Employee[]

  @@map("departments")
}

/// Advisory lock so two people do not edit the same mail draft at once.
model DraftLock {
  messageId String @id @map("message_id")

  heldById String   @map("held_by_id") @db.Uuid
  heldBy   Employee @relation(fields: [heldById], references: [id], onDelete: Cascade)

  acquiredAt DateTime @default(now()) @map("acquired_at") @db.Timestamptz(3)

  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@index([heldById])
  @@map("draft_locks")
}

/// Append-only record of who did what, enforced by a database trigger.
model AuditEvent {
  id String @id @default(uuid()) @db.Uuid

  actorEmployeeId String?   @map("actor_employee_id") @db.Uuid
  actor           Employee? @relation("AuditActor", fields: [actorEmployeeId], references: [id], onDelete: SetNull)

  action String

  targetEmployeeId String?   @map("target_employee_id") @db.Uuid
  target           Employee? @relation("AuditTarget", fields: [targetEmployeeId], references: [id], onDelete: SetNull)

  moduleKey String? @map("module_key")

  metadata Json?

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([targetEmployeeId, occurredAt])
  @@index([actorEmployeeId, occurredAt])
  @@index([action, occurredAt])
  @@index([occurredAt])
  @@map("audit_events")
}

/// Controlled vocabulary of equipment kinds (AHU, VAV, chiller).
model BasEquipmentType {
  equipType   String @id @map("equip_type")
  displayName String @map("display_name")
  description String

  category String

  equipment BasEquipment[]

  @@map("bas_equipment_types")
}

/// Controlled vocabulary of what kind of measurement a point is.
model BasPointRole {
  pointRole   String @id @map("point_role")
  displayName String @map("display_name")
  description String

  measurement String?
  typicalUnit String? @map("typical_unit")

  isSetpoint Boolean @default(false) @map("is_setpoint")
  isCommand  Boolean @default(false) @map("is_command")
  isStatus   Boolean @default(false) @map("is_status")

  setpointFor     String?        @map("setpoint_for")
  setpointForRole BasPointRole?  @relation("BasRoleSetpointFor", fields: [setpointFor], references: [pointRole], onDelete: Restrict)
  setpointForBy   BasPointRole[] @relation("BasRoleSetpointFor")

  statusOf     String?        @map("status_of")
  statusOfRole BasPointRole?  @relation("BasRoleStatusOf", fields: [statusOf], references: [pointRole], onDelete: Restrict)
  statusOfBy   BasPointRole[] @relation("BasRoleStatusOf")

  points BasPoint[]

  @@map("bas_point_roles")
}

/// The customer or business unit that owns a set of buildings.
model BasOrg {
  orgId     BigInt    @id @default(autoincrement()) @map("org_id")
  name      String    @unique
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  projects BasProject[]
  sites    BasSite[]

  @@map("bas_orgs")
}

/// A property or campus that groups several buildings.
model BasProject {
  projectId BigInt @id @default(autoincrement()) @map("project_id")

  orgId BigInt @map("org_id")
  org   BasOrg @relation(fields: [orgId], references: [orgId], onDelete: Restrict)

  name      String
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  sites BasSite[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("bas_projects")
}

/// A building.
model BasSite {
  siteId BigInt @id @default(autoincrement()) @map("site_id")

  orgId BigInt @map("org_id")
  org   BasOrg @relation(fields: [orgId], references: [orgId], onDelete: Restrict)

  projectId BigInt     @map("project_id")
  project   BasProject @relation(fields: [projectId], references: [projectId], onDelete: Restrict)

  name    String
  address String?

  timezone String

  areaSqft Int? @map("area_sqft")

  attributes Json @default("{}")

  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  stations  BasStation[]
  equipment BasEquipment[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("bas_sites")
}

/// A Niagara station (JACE or Supervisor); one row per controller.
model BasStation {
  stationId BigInt @id @default(autoincrement()) @map("station_id")

  siteId BigInt  @map("site_id")
  site   BasSite @relation(fields: [siteId], references: [siteId], onDelete: Restrict)

  displayName String? @map("display_name")

  niagaraStationName String @map("niagara_station_name")

  connectionMode String @default("via_parent") @map("connection_mode")

  baseUrl        String? @map("base_url")

  tlsSha256 String? @map("tls_sha256")

  hostId         String? @map("host_id")
  model          String?
  niagaraVersion String? @map("niagara_version")

  clockOffsetS    Int?      @map("clock_offset_s")
  clockMeasuredAt DateTime? @map("clock_measured_at") @db.Timestamptz()

  parentStationId BigInt?      @map("parent_station_id")
  parentStation   BasStation?  @relation("BasStationParent", fields: [parentStationId], references: [stationId], onDelete: Restrict)
  childStations   BasStation[] @relation("BasStationParent")

  isActive    Boolean   @default(true) @map("is_active")
  notes       String?
  firstSeenAt DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz()
  lastSeenAt  DateTime? @map("last_seen_at") @db.Timestamptz()

  points     BasPoint[]
  ingestRuns BasIngestRun[]
  credential BasStationCredential?

  @@unique([siteId, niagaraStationName])
  @@index([siteId])
  @@map("bas_stations")
}

/// The encrypted Niagara login the collector uses for one station.
model BasStationCredential {
  stationId BigInt @id @map("station_id")

  station BasStation @relation(fields: [stationId], references: [stationId], onDelete: Cascade)

  username String

  passwordCiphertext String @map("password_ciphertext")

  keyVersion Int @map("key_version")

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  updatedById String?   @map("updated_by") @db.Uuid
  updatedBy   Employee? @relation("BasCredentialUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
  @@map("bas_station_credentials")
}

/// A physical piece of equipment, such as AHU-3 or VAV-204.
model BasEquipment {
  equipmentId BigInt @id @default(autoincrement()) @map("equipment_id")

  siteId BigInt  @map("site_id")
  site   BasSite @relation(fields: [siteId], references: [siteId], onDelete: Restrict)

  name String

  equipType     String?           @map("equip_type")
  equipmentType BasEquipmentType? @relation(fields: [equipType], references: [equipType], onDelete: Restrict)

  parentEquipmentId BigInt?        @map("parent_equipment_id")
  parentEquipment   BasEquipment?  @relation("BasEquipmentParent", fields: [parentEquipmentId], references: [equipmentId], onDelete: Restrict)
  childEquipment    BasEquipment[] @relation("BasEquipmentParent")

  attributes Json     @default("{}")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  points BasPoint[]

  @@unique([siteId, name])
  @@index([siteId])
  @@index([equipType])
  @@index([parentEquipmentId])
  @@map("bas_equipment")
}

/// One trended value in a building, keyed by station and Niagara history name.
model BasPoint {
  pointId BigInt @id @default(autoincrement()) @map("point_id")

  stationId BigInt     @map("station_id")
  station   BasStation @relation(fields: [stationId], references: [stationId], onDelete: Restrict)

  equipmentId BigInt?       @map("equipment_id")
  equipment   BasEquipment? @relation(fields: [equipmentId], references: [equipmentId], onDelete: Restrict)

  niagaraHistoryName String  @map("niagara_history_name")
  niagaraHistoryOrd  String? @map("niagara_history_ord")

  niagaraDisplayName String? @map("display_name")

  label String?

  isVisible Boolean @default(true) @map("is_visible")

  pointRole String?       @map("point_role")
  role      BasPointRole? @relation(fields: [pointRole], references: [pointRole], onDelete: Restrict)

  unit String?

  dataType       String  @default("unknown") @map("data_type")
  sourceTimezone String? @map("source_timezone")

  collectionIntervalS Int? @map("collection_interval_s")

  capacity Int?

  fullPolicy String? @map("full_policy")

  rollHorizonS Int? @map("roll_horizon_s")

  tags  Json    @default("{}")
  notes String?

  isActive    Boolean   @default(true) @map("is_active")

  inactiveReason String? @map("inactive_reason")

  firstSeenAt DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz()
  lastSeenAt  DateTime? @map("last_seen_at") @db.Timestamptz()

  readings   BasReading[]
  checkpoint BasSyncCheckpoint?
  gaps       BasDataGap[]
  linksFrom  BasPointLink[]     @relation("BasLinkFrom")
  linksTo    BasPointLink[]     @relation("BasLinkTo")

  @@unique([stationId, niagaraHistoryName])
  @@index([stationId])
  @@index([equipmentId])
  @@index([pointRole])
  @@index([isActive])
  @@map("bas_points")
}

/// One trend record; append-only, never updated or deleted.
model BasReading {
  pointId BigInt   @map("point_id")
  point   BasPoint @relation(fields: [pointId], references: [pointId], onDelete: Cascade)

  ts DateTime @db.Timestamptz()

  valueNum  Float?   @map("value_num")
  valueBool Boolean? @map("value_bool")
  valueStr  String?  @map("value_str")

  status String?

  @@id([pointId, ts])
  @@index([ts], type: Brin)
  @@map("bas_readings")
}

/// An explicit relationship between two points the role vocabulary cannot infer.
model BasPointLink {
  fromPointId BigInt   @map("from_point_id")
  fromPoint   BasPoint @relation("BasLinkFrom", fields: [fromPointId], references: [pointId], onDelete: Cascade)

  toPointId BigInt   @map("to_point_id")
  toPoint   BasPoint @relation("BasLinkTo", fields: [toPointId], references: [pointId], onDelete: Cascade)

  linkType String @map("link_type")

  confidence String @default("manual")

  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@id([fromPointId, toPointId, linkType])
  @@index([toPointId])
  @@map("bas_point_links")
}

/// Per-point collector high-water mark and completeness verdict.
model BasSyncCheckpoint {
  pointId BigInt   @id @map("point_id")
  point   BasPoint @relation(fields: [pointId], references: [pointId], onDelete: Cascade)

  lastRecordTs DateTime? @map("last_record_ts") @db.Timestamptz()
  lastRunAt    DateTime? @map("last_run_at") @db.Timestamptz()

  lastStatus          String  @default("never_run") @map("last_status")
  consecutiveFailures Int     @default(0) @map("consecutive_failures")
  lastError           String? @map("last_error")

  completeness          String    @default("unknown")
  completenessCheckedAt DateTime? @map("completeness_checked_at") @db.Timestamptz()
  completenessNote      String?   @map("completeness_note")

  stationCount Int?      @map("station_count")
  stationStart DateTime? @map("station_start") @db.Timestamptz()
  stationEnd   DateTime? @map("station_end") @db.Timestamptz()
  heldCount    Int?      @map("held_count")

  observedSpanS Int? @map("observed_span_s")

  shortestFullSpanS Int? @map("shortest_full_span_s")

  @@map("bas_sync_checkpoints")
}

/// One row per collector run, with its status and counts.
model BasIngestRun {
  runId BigInt @id @default(autoincrement()) @map("run_id")

  stationId BigInt?     @map("station_id")
  station   BasStation? @relation(fields: [stationId], references: [stationId], onDelete: Restrict)

  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz()
  finishedAt DateTime? @map("finished_at") @db.Timestamptz()

  status String @default("running")

  windowStart DateTime? @map("window_start") @db.Timestamptz()
  windowEnd   DateTime? @map("window_end") @db.Timestamptz()

  pointsAttempted Int @default(0) @map("points_attempted")
  pointsSucceeded Int @default(0) @map("points_succeeded")
  recordsWritten  Int @default(0) @map("records_written")

  pointsIncomplete  Int @default(0) @map("points_incomplete")
  pointsBackfilling Int @default(0) @map("points_backfilling")

  errors Json @default("[]")

  collectorVersion String? @map("collector_version")
  collectorHost    String? @map("collector_host")

  @@index([startedAt(sort: Desc)])
  @@map("bas_ingest_runs")
}

/// A period of known missing data for a point, and why.
model BasDataGap {
  gapId BigInt @id @default(autoincrement()) @map("gap_id")

  pointId BigInt   @map("point_id")
  point   BasPoint @relation(fields: [pointId], references: [pointId], onDelete: Cascade)

  gapStart   DateTime @map("gap_start") @db.Timestamptz()
  gapEnd     DateTime @map("gap_end") @db.Timestamptz()
  detectedAt DateTime @default(now()) @map("detected_at") @db.Timestamptz()

  cause String

  notes String?

  @@unique([pointId, gapStart, cause])
  @@index([pointId, gapStart])
  @@map("bas_data_gaps")
}

/// A record of all claude skills for the cost intelligence platform
model CipSkill {
  id           BigInt   @id @default(autoincrement())
  name         String
  description  String
  version      Int
  locationPath String   @map("location_path")
  folderName   String   @unique @map("folder_name")
  lastModified DateTime @map("last_modified") @db.Timestamptz(3)
  lastSynced   DateTime @map("last_synced") @db.Timestamptz(3)

  @@map("cip_skills")
}

/// A record of all syncs triggered for claude skills in the cost intelligence platform
model CipSkillSync {
  id            BigInt    @id @default(autoincrement())
  trigger       String
  triggeredById String?   @map("triggered_by_id") @db.Uuid
  triggeredBy   Employee? @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  status        String    @default("running")
  skillsSeen    Int       @default(0) @map("skills_seen")
  skillsAdded   Int       @default(0) @map("skills_added")
  skillsUpdated Int       @default(0) @map("skills_updated")
  skillsDeleted Int       @default(0) @map("skills_deleted")
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(3)
  errors        Json      @default("[]")

  @@index([startedAt(sort: Desc)])
  @@map("cip_skill_syncs")
}

/// A named, ordered list of skills that a run executes; built by PCEs in Settings
model CipWorkflow {
  id          BigInt    @id @default(autoincrement())
  name        String
  description String?
  status      String    @default("draft")
  createdById String?   @map("created_by_id") @db.Uuid
  createdBy   Employee? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  steps CipWorkflowStep[]
  runs  CipRun[]

  @@map("cip_workflows")
}

/// One skill in a workflow, stored by folder name so a skill gone from the folder shows as missing instead of blocking sync
model CipWorkflowStep {
  id              BigInt      @id @default(autoincrement())
  workflowId      BigInt      @map("workflow_id")
  workflow        CipWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  position        Int
  skillFolderName String      @map("skill_folder_name")

  @@unique([workflowId, position])
  @@unique([workflowId, skillFolderName])
  @@map("cip_workflow_steps")
}

/// A project folder in BID-DOC; metadata only, the files themselves are read at run time
model CipProject {
  id           BigInt    @id @default(autoincrement())
  folderName   String    @unique @map("folder_name")
  locationPath String    @map("location_path")
  categories   String[]  @default([])
  fileCount    Int       @map("file_count")
  totalBytes   BigInt    @map("total_bytes")
  lastModified DateTime? @map("last_modified") @db.Timestamptz(3)
  aiFileCount  Int?      @map("ai_file_count")
  lastSynced   DateTime  @map("last_synced") @db.Timestamptz(3)
  removedAt    DateTime? @map("removed_at") @db.Timestamptz(3)
  /// The file tree as of the last sync: { tree, truncated }. Null until the next sync.
  fileTree     Json?     @map("file_tree")

  runs CipRun[]

  @@map("cip_projects")
}

/// A record of every project sync, manual or scheduled
model CipProjectSync {
  id              BigInt    @id @default(autoincrement())
  trigger         String
  triggeredById   String?   @map("triggered_by_id") @db.Uuid
  triggeredBy     Employee? @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  status          String    @default("running")
  projectsSeen    Int       @default(0) @map("projects_seen")
  projectsAdded   Int       @default(0) @map("projects_added")
  projectsUpdated Int       @default(0) @map("projects_updated")
  projectsRemoved Int       @default(0) @map("projects_removed")
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz(3)
  errors          Json      @default("[]")

  @@index([startedAt(sort: Desc)])
  @@map("cip_project_syncs")
}

/// One execution of a workflow against a project. Also the job queue: the worker claims `queued` runs
model CipRun {
  id            BigInt       @id @default(autoincrement())
  workflowId    BigInt?      @map("workflow_id")
  workflow      CipWorkflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  workflowName  String       @map("workflow_name")
  projectId     BigInt       @map("project_id")
  project       CipProject   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  steps         Json
  status        String       @default("queued")
  currentStep   Int          @default(0) @map("current_step")
  sessionId     String?      @map("session_id")
  model         String
  budgetUsd     Decimal      @map("budget_usd") @db.Decimal(10, 2)
  costUsd       Decimal      @default(0) @map("cost_usd") @db.Decimal(12, 6)
  inputTokens   BigInt       @default(0) @map("input_tokens")
  outputTokens  BigInt       @default(0) @map("output_tokens")
  error         String?
  startedById   String?      @map("started_by_id") @db.Uuid
  startedBy     Employee?    @relation(fields: [startedById], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt     DateTime?    @map("started_at") @db.Timestamptz(3)
  heartbeatAt   DateTime?    @map("heartbeat_at") @db.Timestamptz(3)
  finishedAt    DateTime?    @map("finished_at") @db.Timestamptz(3)

  events      CipRunEvent[]
  checkpoints CipRunCheckpoint[]
  transcripts CipRunTranscript[]

  @@index([createdAt(sort: Desc)])
  @@index([status])
  @@map("cip_runs")
}

/// The run ledger: append-only, one row per thing that happened, outputs included
model CipRunEvent {
  id      BigInt   @id @default(autoincrement())
  runId   BigInt   @map("run_id")
  run     CipRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  step    Int?
  type    String
  message String
  data    Json     @default("{}")
  at      DateTime @default(now()) @db.Timestamptz(3)

  @@index([runId, id])
  @@map("cip_run_events")
}

/// A question a skill asked a person mid-run; the run waits until it is answered
model CipRunCheckpoint {
  id           BigInt    @id @default(autoincrement())
  runId        BigInt    @map("run_id")
  run          CipRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  step         Int
  question     String
  options      Json      @default("[]")
  answer       String?
  answeredById String?   @map("answered_by_id") @db.Uuid
  answeredBy   Employee? @relation(fields: [answeredById], references: [id], onDelete: SetNull)
  askedAt      DateTime  @default(now()) @map("asked_at") @db.Timestamptz(3)
  answeredAt   DateTime? @map("answered_at") @db.Timestamptz(3)

  @@index([runId])
  @@map("cip_run_checkpoints")
}

/// The Agent SDK session transcript, mirrored here so a paused run can resume in a fresh container
model CipRunTranscript {
  id        BigInt @id @default(autoincrement())
  runId     BigInt @map("run_id")
  run       CipRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  sessionId String @map("session_id")
  subpath   String @default("")
  entryUuid String? @map("entry_uuid")
  entry     Json

  @@index([runId, sessionId, subpath, id])
  @@map("cip_run_transcripts")
}

// ---------------------------------------------------------------------------
// Freeze Protection (fp_). Entered by hand in the platform, so the platform is
// the source of truth and stores everything. Closed vocabularies are text with
// CHECK constraints in the migration, matching lib/modules/freeze-protection/types.ts.
// ---------------------------------------------------------------------------

/// A construction job whose equipment is verified for freeze protection. Not linked to BAS or any other module
model FpProject {
  id          BigInt    @id @default(autoincrement())
  jobNumber   String    @map("job_number")
  name        String
  createdById String?   @map("created_by_id") @db.Uuid
  createdBy   Employee? @relation("FpProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  buildings     FpBuilding[]
  verifications FpVerification[]

  @@map("fp_projects")
}

/// A building on a project. Every unit belongs to one; a single-building job has one
model FpBuilding {
  id        BigInt    @id @default(autoincrement())
  projectId BigInt    @map("project_id")
  project   FpProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  equipment FpEquipment[]

  @@index([projectId])
  @@map("fp_buildings")
}

/// One line of the mechanical equipment schedule: what the unit is and where. Results live per round in fp_results
model FpEquipment {
  id            BigInt     @id @default(autoincrement())
  buildingId    BigInt     @map("building_id")
  building      FpBuilding @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  tag           String
  equipmentType String?    @map("equipment_type")
  areaServed    String?    @map("area_served")
  /// Step 2. Null until answered; 'none' closes the line in every round
  coil          String?
  /// When coil last changed. Coil is a unit fact read by every round, so a change after a review is that round's change too
  coilUpdatedAt DateTime?  @map("coil_updated_at") @db.Timestamptz(3)
  notes         String?
  sortOrder     Int        @default(0) @map("sort_order")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  results FpResult[]

  @@index([buildingId])
  @@map("fp_equipment")
}

/// One verification round on a project: the date it speaks for, its signoff (step 7) and transmittal
model FpVerification {
  id               BigInt    @id @default(autoincrement())
  projectId        BigInt    @map("project_id")
  project          FpProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  verificationDate DateTime  @map("verification_date") @db.Date
  completedById    String?   @map("completed_by_id") @db.Uuid
  completedBy      Employee? @relation("FpVerificationCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(3)
  reviewedById     String?   @map("reviewed_by_id") @db.Uuid
  reviewedBy       Employee? @relation("FpVerificationReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamptz(3)
  transmittedTo    String?   @map("transmitted_to")
  transmittedDate  DateTime? @map("transmitted_date") @db.Date
  createdById      String?   @map("created_by_id") @db.Uuid
  createdBy        Employee? @relation("FpVerificationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  results FpResult[]

  @@index([projectId, verificationDate(sort: Desc)])
  @@map("fp_verifications")
}

/// One unit in one round: its status and steps 3 to 6. Null means not answered yet
model FpResult {
  id                    BigInt         @id @default(autoincrement())
  verificationId        BigInt         @map("verification_id")
  verification          FpVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  equipmentId           BigInt         @map("equipment_id")
  equipment             FpEquipment    @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  status                String         @default("service")
  exposure              String?
  protection            String?
  testFanStops          String?        @map("test_fan_stops")
  testDamperCloses      String?        @map("test_damper_closes")
  testValveFullFlow     String?        @map("test_valve_full_flow")
  testManualReset       String?        @map("test_manual_reset")
  tripTempF             Float?         @map("trip_temp_f")
  testedBy              String?        @map("tested_by")
  testDate              DateTime?      @map("test_date") @db.Date
  elements              String?
  notifyWho             String?        @map("notify_who")
  notifyDate            DateTime?      @map("notify_date") @db.Date
  notifyMethod          String?        @map("notify_method")
  notifyResponse        String?        @map("notify_response")
  deficiencyDescription String?        @map("deficiency_description")
  deficiencyOwner       String?        @map("deficiency_owner")
  deficiencyDue         DateTime?      @map("deficiency_due") @db.Date
  documentedWith        String?        @map("documented_with")
  documentedName        String?        @map("documented_name")
  documentedDate        DateTime?      @map("documented_date") @db.Date
  documentedMethod      String?        @map("documented_method")
  notes                 String?
  updatedById           String?        @map("updated_by_id") @db.Uuid
  updatedBy             Employee?      @relation("FpResultUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([verificationId, equipmentId])
  @@index([equipmentId])
  @@map("fp_results")
}
