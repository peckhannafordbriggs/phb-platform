# Everything here is either rebuilt inside the image, useless to it, or must
# never enter it. A smaller context is also a faster build.

# Reinstalled by `npm ci` in the deps stage. Copying a host node_modules would
# ship whatever architecture the developer's machine is.
node_modules
**/node_modules

# Regenerated by `npx prisma generate` in the build stage.
lib/generated

# Build output. The image builds its own.
.next
out
build
dist
*.tsbuildinfo

# --- Secrets. The reason this file matters most. -------------------------------
# .env.local holds a real database password and a real client secret. An image
# layer is readable by anyone who can pull the image, and deleting the file in a
# later layer does not remove it from the earlier one.
.env
.env.*
!.env.example

# Version control and CI
.git
.gitignore
.github

# Tests and test tooling. Not run in the image, and tests/setup.ts refuses to
# run without a test database anyway.
tests
vitest.config.mts

# Documentation
docs
*.md
!README.md

# Local tooling and editor state
.claude
.vscode
.idea
scripts/tmp-*

# Container files themselves
Dockerfile
.dockerignore

# Infrastructure definitions - deployed by CI, never needed at runtime
infra
