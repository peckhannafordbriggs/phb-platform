# Copy to .env.local and fill in. Never commit a filled-in copy.
#
# ---------------------------------------------------------------------------
# Where each variable comes from in production
# ---------------------------------------------------------------------------
# Nothing in Azure reads this file. Each variable below is annotated with its
# production source, and there are exactly three of them:
#
#   [key vault]   A secret. Stored in Key Vault, referenced by the container app
#                 through the user-assigned managed identity, so the value is
#                 never in the resource definition, the deployment history, or
#                 `az containerapp show`. Defined in infra/main.bicep.
#   [app config]  Not a secret. A plain environment variable on the container
#                 app, set from a Bicep parameter.
#   [local only]  Never set in Azure. Some are refused there outright.
#
# The full picture is infra/main.bicep; this list is the one a person reads.

# --- Database -------------------------------------------------------------
# Local PostgreSQL 17. The database must exist before `prisma migrate dev`.
# [key vault] DATABASE-URL. Built by Bicep from the server FQDN and the admin
# credential, with sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/phb_platform?schema=public"

# Used only by `npm test`. Must point at a DIFFERENT database than DATABASE_URL:
# the test suite truncates every table between files.
# [local only] and CI. There is no test database in Azure.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/phb_platform_test?schema=public"

# --- Auth.js --------------------------------------------------------------
# Generate with: npx auth secret
# [key vault] AUTH-SECRET.
AUTH_SECRET=""
# [app config] The public container app URL. Empty on the first deployment,
# because the URL does not exist until the container app does.
AUTH_URL="http://localhost:3000"

# Entra ID app registration dedicated to platform SSO.
# This is NOT the Graph mail app registration - they stay separate.
# [app config] A client ID is an identifier, not a credential.
AUTH_MICROSOFT_ENTRA_ID_ID=""
# Local development only. Production uses managed identity; never set this in Azure.
# [local only] Production uses a federated identity credential.
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# [app config]
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=""

# --- Login gate -----------------------------------------------------------
# Comma-separated. A verified email domain outside this list is rejected.
# [app config] Confirm the full verified-domain list with IT before deploying.
ALLOWED_EMAIL_DOMAINS="phb1899.com"

# Comma-separated, like ALLOWED_EMAIL_DOMAINS. Each address gets an employee row
# with is_platform_admin true and no profile yet; their first sign-in stamps the
# Entra object ID onto that row. Every admin after these is made in the UI.
#
# Re-running the seed never re-promotes someone demoted through the UI - the only
# exception is a total lockout, when no active administrator remains.
# [app config] All four addresses. If this is wrong when the production seed
# runs, production comes up with zero admins and there is no UI path to fix it.
BOOTSTRAP_ADMIN_EMAIL="first.admin@phb1899.com,second.admin@phb1899.com"

# --- Send gate ------------------------------------------------------------
# Enforced inside the mail service. Any send throws unless this is exactly
# "true". Never set it to true outside production.
# [app config] Pinned to false in infra/main.bicep until an end-to-end send has
# been verified by a human.
PHB_ALLOW_SEND=false

# Expiry Date of Entra : 

#--------------------------------------------------------------------------------------------------

# --- Microsoft Graph: Change Order mailbox --------------------------------
# Second app registration, separate from SSO. Application permissions:
# Mail.ReadWrite + Mail.Send, scoped to one mailbox by ApplicationAccessPolicy.
#
# None of these are required for the platform to boot. Leave them empty and the
# app still starts and serves every other screen; the mailbox health endpoint
# reports which ones are missing.
# [app config]
GRAPH_CLIENT_ID=""
# Local development only. Production uses a federated identity credential, and
# the credential factory REFUSES to start if this is set with NODE_ENV=production.
# [local only] NOT set in Azure, and not defined by infra/main.bicep at all.
# createGraphCredential throws if it is present with NODE_ENV=production.
GRAPH_CLIENT_SECRET=""
# [app config]
GRAPH_TENANT_ID=""

# Azure only, and optional. The client ID of the user-assigned managed identity
# that federates to the app registration above. Leave unset to use the
# system-assigned identity. Never set locally.
# [app config] Output by Bicep from the user-assigned identity it creates.
GRAPH_MANAGED_IDENTITY_CLIENT_ID=""

# The only mailbox this app may touch. Not a parameter on any mail service
# method - the address comes from here so no call site can point elsewhere.
# [app config]
CO_MAILBOX="changeorder@phb1899.com"
