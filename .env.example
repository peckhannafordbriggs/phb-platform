# Copy to .env.local and fill in. Never commit a filled-in copy.

# --- Database -------------------------------------------------------------
# Local PostgreSQL 17. The database must exist before `prisma migrate dev`.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/phb_platform?schema=public"

# Used only by `npm test`. Must point at a DIFFERENT database than DATABASE_URL:
# the test suite truncates every table between files.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/phb_platform_test?schema=public"

# --- Auth.js --------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Entra ID app registration dedicated to platform SSO.
# This is NOT the Graph mail app registration - they stay separate.
AUTH_MICROSOFT_ENTRA_ID_ID=""
# Local development only. Production uses managed identity; never set this in Azure.
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=""

# --- Login gate -----------------------------------------------------------
# Comma-separated. A verified email domain outside this list is rejected.
ALLOWED_EMAIL_DOMAINS="phb1899.com"

# Seeded as the first platform admin. Every admin after this one is made in the UI.
BOOTSTRAP_ADMIN_EMAIL=""

# --- Reserved for Phase 3 -------------------------------------------------
# Nothing reads this yet. It must stay false outside production.
PHB_ALLOW_SEND=false
