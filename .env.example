# Copy to .env.local and fill in. Never commit a filled-in copy.

# --- Database -------------------------------------------------------------
# Local PostgreSQL 17. The database must exist before `prisma migrate dev`.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/phb_platform?schema=public"

# Used only by `npm test`. Must point at a DIFFERENT database than DATABASE_URL:
# the test suite truncates every table between files.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/phb_platform_test?schema=public"

# --- Auth.js --------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Entra ID app registration dedicated to platform SSO.
# This is NOT the Graph mail app registration - they stay separate.
AUTH_MICROSOFT_ENTRA_ID_ID=""
# Local development only. Production uses managed identity; never set this in Azure.
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=""

# --- Login gate -----------------------------------------------------------
# Comma-separated. A verified email domain outside this list is rejected.
ALLOWED_EMAIL_DOMAINS="phb1899.com"

# Seeded as the first platform admin. Every admin after this one is made in the UI.
BOOTSTRAP_ADMIN_EMAIL=""

# --- Send gate ------------------------------------------------------------
# Enforced inside the mail service. Any send throws unless this is exactly
# "true". Never set it to true outside production.
PHB_ALLOW_SEND=false

# Expiry Date of Entra : 

#--------------------------------------------------------------------------------------------------

# --- Microsoft Graph: Change Order mailbox --------------------------------
# Second app registration, separate from SSO. Application permissions:
# Mail.ReadWrite + Mail.Send, scoped to one mailbox by ApplicationAccessPolicy.
#
# None of these are required for the platform to boot. Leave them empty and the
# app still starts and serves every other screen; the mailbox health endpoint
# reports which ones are missing.
GRAPH_CLIENT_ID=""
# Local development only. Production uses a federated identity credential, and
# the credential factory REFUSES to start if this is set with NODE_ENV=production.
GRAPH_CLIENT_SECRET=""
GRAPH_TENANT_ID=""

# Azure only, and optional. The client ID of the user-assigned managed identity
# that federates to the app registration above. Leave unset to use the
# system-assigned identity. Never set locally.
GRAPH_MANAGED_IDENTITY_CLIENT_ID=""

# The only mailbox this app may touch. Not a parameter on any mail service
# method - the address comes from here so no call site can point elsewhere.
CO_MAILBOX="changeorder@phb1899.com"
